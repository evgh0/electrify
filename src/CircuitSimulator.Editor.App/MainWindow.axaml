<Window
    x:Class="CircuitSimulator.Editor.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:documents="using:CircuitSimulator.Editor.Documents"
    xmlns:rendering="using:CircuitSimulator.Editor.Rendering"
    xmlns:viewModels="using:CircuitSimulator.Editor.ViewModels"
    Title="Electrify · Transient Lab"
    Width="1360"
    Height="850"
    MinWidth="1080"
    MinHeight="680">

  <Window.DataTemplates>
    <DataTemplate DataType="documents:DemoCircuitDefinition">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" MaxWidth="190" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="viewModels:ComponentListItemViewModel">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>

    <DataTemplate DataType="viewModels:ParameterFieldViewModel">
      <StackPanel Spacing="4" Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding DisplayName}" Classes="caption" />
          <TextBlock Grid.Column="1" Text="{Binding Unit}" Classes="caption" />
        </Grid>
        <TextBox
            Text="{Binding Text, Mode=TwoWay}"
            AutomationProperties.Name="{Binding DisplayName}" />
        <TextBlock
            Text="{Binding Error}"
            Foreground="{DynamicResource Error}"
            FontSize="11"
            IsVisible="{Binding HasError}" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="48,*,24" ColumnDefinitions="52,230,*,300">
    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="14,0" VerticalAlignment="Center">
        <TextBlock Text="◈" Foreground="{DynamicResource Accent}" FontSize="22" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Electrify" FontWeight="SemiBold" />
          <TextBlock Text="TRANSIENT LAB" Classes="caption" FontSize="9" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="caption" VerticalAlignment="Center" Margin="24,0" />
        <Button Grid.Column="3" Classes="ghost" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,6,0" />
        <Button Grid.Column="4" Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
        <Button Grid.Column="5" Classes="primary" Content="Run" Command="{Binding RunCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
      <StackPanel HorizontalAlignment="Center" Margin="0,12" Spacing="12">
        <Border Width="34" Height="34" CornerRadius="7" Background="{DynamicResource SelectionBackground}">
          <TextBlock Text="⌁" FontSize="21" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SIM" Classes="caption" FontSize="9" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto,*">
        <TextBlock Text="EXAMPLE" Classes="caption" Margin="4,2,0,7" />
        <ComboBox
            Grid.Row="1"
            ItemsSource="{Binding Examples}"
            SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"
            AutomationProperties.Name="Circuit example" />
        <ListBox
            Grid.Row="2"
            Margin="0,14,0,8"
            ItemsSource="{Binding Examples}"
            SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"
            AutomationProperties.Name="Examples" />
        <TextBlock Grid.Row="3" Text="COMPONENTS" Classes="caption" Margin="4,8,0,7" />
        <ListBox
            Grid.Row="4"
            ItemsSource="{Binding Components}"
            SelectedItem="{Binding SelectedComponentItem, Mode=TwoWay}"
            AutomationProperties.Name="Circuit components" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="280,5,*" Margin="12">
      <Border Classes="card" Padding="8">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="8,4,8,2" ColumnDefinitions="*,Auto">
            <TextBlock Text="Circuit" Classes="heading" />
            <TextBlock Grid.Column="1" Text="Click a component to inspect" Classes="caption" VerticalAlignment="Center" />
          </Grid>
          <rendering:CircuitDiagramControl
              x:Name="CircuitDiagram"
              Grid.Row="1"
              Circuit="{Binding CurrentInstance}"
              SelectedComponent="{Binding SelectedComponent}"
              WireBrush="{DynamicResource WireDefault}"
              SymbolBrush="{DynamicResource TextPrimary}"
              SecondaryBrush="{DynamicResource TextSecondary}"
              AccentBrush="{DynamicResource Accent}"
              SelectionBrush="{DynamicResource SelectionOverlay}"
              AutomationProperties.Name="Circuit diagram" />
        </Grid>
      </Border>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
      <Border Grid.Row="2" Classes="card" Padding="8" Margin="0,8,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="8,4,8,2" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="Waveforms" Classes="heading" />
              <TextBlock Text="V · I · P" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Hover or use ← →" Classes="caption" VerticalAlignment="Center" />
          </Grid>
          <rendering:TransientChartControl
              x:Name="WaveformChart"
              Grid.Row="1"
              Data="{Binding ChartData}"
              GridBrush="{DynamicResource GridMajor}"
              TraceBrush="{DynamicResource Accent}"
              ReferenceBrush="{DynamicResource ReferenceTrace}"
              TextBrush="{DynamicResource TextPrimary}"
              SecondaryBrush="{DynamicResource TextSecondary}"
              AutomationProperties.Name="Transient waveforms" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0" Padding="16">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <StackPanel>
            <TextBlock Text="INSPECTOR" Classes="caption" />
            <TextBlock Text="{Binding SelectedComponentTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="{Binding SelectedComponentKind}" Foreground="{DynamicResource Accent}" />
          </StackPanel>

          <Border Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
              <TextBlock Text="Cursor" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding CursorTime}" />
              <TextBlock Grid.Row="1" Text="Voltage" Classes="caption" Margin="0,8,0,0" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CursorVoltage}" Margin="0,8,0,0" />
              <TextBlock Grid.Row="2" Text="Current" Classes="caption" Margin="0,8,0,0" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CursorCurrent}" Margin="0,8,0,0" />
              <TextBlock Grid.Row="3" Text="Power" Classes="caption" Margin="0,8,0,0" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CursorPower}" Margin="0,8,0,0" />
            </Grid>
          </Border>

          <TextBlock Text="PARAMETERS" Classes="caption" />
          <ItemsControl ItemsSource="{Binding ParameterFields}" />
          <Button Classes="primary" Content="Apply &amp; Run" Command="{Binding ApplyAndRunCommand}" HorizontalAlignment="Stretch" />

          <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource Error}" BorderThickness="1" CornerRadius="5" Padding="10" IsVisible="{Binding HasErrorMessage}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{DynamicResource Accent}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="7,0" VerticalAlignment="Center" FontSize="11" />
        <TextBlock Grid.Column="2" Text="Backward Euler · Core MNA" VerticalAlignment="Center" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
