<Window
    x:Class="CircuitSimulator.RealtimeDemo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rendering="using:CircuitSimulator.RealtimeDemo.Rendering"
    Title="Electrify · Realtime RC Filter"
    Width="1320"
    Height="780"
    MinWidth="980"
    MinHeight="620">

  <Grid RowDefinitions="58,*,28">
    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Realtime RC Filter" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Fixed 5 ms integration · rolling 10 second view" Classes="caption" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Two-stage low-pass driven by a 1 Hz sinusoidal source" Classes="caption" VerticalAlignment="Center" Margin="24,0" />
        <Border Grid.Column="2" Background="#182B29" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
          <TextBlock Text="CORE REALTIME" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="3*,5,2*" Margin="14">
      <Border Grid.Column="0" Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="7,2,7,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Selected component" FontWeight="SemiBold" />
              <TextBlock x:Name="ChartComponentText" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="V · I · P" Foreground="{DynamicResource SecondaryText}" />
          </Grid>
          <rendering:RealtimeWaveformControl
              x:Name="WaveformChart"
              Grid.Row="1"
              GridBrush="{DynamicResource GridBrush}"
              VoltageBrush="{DynamicResource VoltageBrush}"
              CurrentBrush="{DynamicResource CurrentBrush}"
              PowerBrush="{DynamicResource PowerBrush}"
              TextBrush="{DynamicResource PrimaryText}"
              SecondaryBrush="{DynamicResource SecondaryText}" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource BorderBrush}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="10,0,0,0">
        <Border Classes="card" Padding="12" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="Component" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox
                x:Name="ComponentSelector"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Selected circuit component" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Select from this list or click a symbol below." Classes="caption" Margin="0,8,0,0" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="8">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Predefined circuit" FontWeight="SemiBold" Margin="8,4" />
            <rendering:FilterSchematicControl
                x:Name="CircuitDiagram"
                Grid.Row="1"
                WireBrush="{DynamicResource SecondaryText}"
                SymbolBrush="{DynamicResource PrimaryText}"
                SecondaryBrush="{DynamicResource SecondaryText}"
                AccentBrush="{DynamicResource AccentBrush}"
                AutomationProperties.Name="Two-stage RC filter schematic" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="14" Margin="0,10,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <TextBlock Text="Latest sample" Classes="caption" />
            <TextBlock x:Name="TimeValue" Grid.Column="1" Text="—" />
            <TextBlock Grid.Row="1" Text="Voltage" Classes="caption" Margin="0,7,0,0" />
            <TextBlock x:Name="VoltageValue" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,7,0,0" Foreground="{DynamicResource VoltageBrush}" />
            <TextBlock Grid.Row="2" Text="Current" Classes="caption" Margin="0,7,0,0" />
            <TextBlock x:Name="CurrentValue" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,7,0,0" Foreground="{DynamicResource CurrentBrush}" />
            <TextBlock Grid.Row="3" Text="Power" Classes="caption" Margin="0,7,0,0" />
            <TextBlock x:Name="PowerValue" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,7,0,0" Foreground="{DynamicResource PowerBrush}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="StatusIndicator" Text="●" Foreground="{DynamicResource SecondaryText}" FontSize="10" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Classes="caption" Margin="7,0" />
        <TextBlock Grid.Column="2" Text="Backward Euler · 200 samples/s" Classes="caption" />
      </Grid>
    </Border>
  </Grid>
</Window>
